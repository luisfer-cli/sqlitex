# ---------------------------------------------------------------------------
# SQLiteX configuration
# Copy this file to `.env` and adjust the values.
# ---------------------------------------------------------------------------

# Default database (optional). If omitted, SQLiteX uses the only catalog in
# SQLITEX_HOME, or you can pass --db on each command.
# SQLITEX_DB=./demo.sqlite

# Directory for catalogs and indexes (default: ./.sqlitex)
# SQLITEX_HOME=.sqlitex

# --- Chat model (OpenAI-compatible API) ------------------------------------
# OpenAI
SQLITEX_API_BASE_URL=https://api.openai.com/v1
SQLITEX_API_KEY=sk-...
SQLITEX_MODEL=gpt-4o-mini

# Local Ollama (no real API key needed)
# SQLITEX_API_BASE_URL=http://localhost:11434/v1
# SQLITEX_API_KEY=ollama
# SQLITEX_MODEL=llama3.1

# Local LM Studio
# SQLITEX_API_BASE_URL=http://localhost:1234/v1
# SQLITEX_API_KEY=lm-studio
# SQLITEX_MODEL=qwen2.5-7b-instruct

# OpenRouter
# SQLITEX_API_BASE_URL=https://openrouter.ai/api/v1
# SQLITEX_API_KEY=sk-or-...
# SQLITEX_MODEL=openai/gpt-4o-mini

# OpenCode Go (requires a session header; any UUID works)
# SQLITEX_API_BASE_URL=https://opencode.ai/zen/go/v1
# SQLITEX_API_KEY=${OPENCODE_GO_API_KEY}
# SQLITEX_MODEL=deepseek-v4.1-flash
# SQLITEX_EXTRA_HEADERS={"x-opencode-session":"${OPENCODE_SESSION_ID}"}
# SQLITEX_EMBEDDINGS=off

# --- Embeddings (optional, for vector RAG) ---------------------------------
# If unset, SQLiteX automatically uses lexical search (BM25).
# SQLITEX_EMBED_MODEL=text-embedding-3-small
# SQLITEX_EMBED_BASE_URL=https://api.openai.com/v1
# SQLITEX_EMBED_API_KEY=sk-...
# SQLITEX_EMBEDDINGS=auto        # auto | on | off

# --- Behavior ---------------------------------------------------------------
# SQLITEX_LANGUAGE=en            # language of AI-generated annotations
# SQLITEX_MAX_ROWS=50            # maximum rows returned by a query
# SQLITEX_QUERY_TIMEOUT=10       # maximum SQL execution time in seconds
# SQLITEX_RETRIEVAL=hybrid       # hybrid | lexical | vector | off
# SQLITEX_TOP_K=6                # tables retrieved for context
# SQLITEX_ALL_TABLES_THRESHOLD=6 # include the whole schema for small databases
# SQLITEX_CONTEXT_MAX_CHARS=24000
# SQLITEX_HISTORY_TURNS=3        # turns remembered in `chat`
# SQLITEX_SQL_RETRIES=2          # automatic SQL repair attempts
# SQLITEX_ENRICH_MAX_TABLES=200
# SQLITEX_ENRICH_WORKERS=4
# SQLITEX_SAMPLE_ROWS=3
# SQLITEX_PROFILE_SAMPLE_ROWS=500
# SQLITEX_PROFILE_MAX_COLUMNS=120
# SQLITEX_TEMPERATURE=0
# SQLITEX_TIMEOUT=60
# SQLITEX_JSON_MODE=false        # true if your provider supports response_format
# SQLITEX_DEBUG=false

# Extra headers for providers that require them (JSON).
# SQLITEX_EXTRA_HEADERS={"HTTP-Referer":"https://example.com","X-Title":"SQLiteX"}
